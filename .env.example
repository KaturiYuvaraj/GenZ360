# ==============================================================================
# Database Configuration for GenZ360
# ==============================================================================
# When DATABASE_URL is unset, GenZ360 uses local embedded PGLite (in-memory Postgres).
# Set DATABASE_URL to connect to any standard PostgreSQL database (e.g. Neon):
#
# DATABASE_URL=postgresql://user:password@ep-example.neon.tech/neondb?sslmode=require
#
DATABASE_URL=

# ==============================================================================
# Automated Company Discovery & ATS Source Registration
# ==============================================================================
# Automatic company discovery allows GenZ360 to find employers, detect their ATS,
# validate job boards, and feed them into the ingestion engine.
# If no discovery provider is configured, the system will cleanly report that
# automatic discovery is unavailable, while preserving all existing employer-created
# jobs, manual ATS boards, and catalog search.

# --- Discovery Provider 1: Commercial Business Directory API (Optional) ---
# Commercial licensed company registry API for discovering corporate domains.
COMPANY_SEARCH_API_KEY=
BUSINESS_DIRECTORY_API_KEY=
# COMPANY_SEARCH_API_URL=https://api.businessdirectory.io/v1/companies

# --- Discovery Provider 2: Google Places API (Optional) ---
# Google Maps / Places API key for identifying corporate headquarters and domains.
# Subject to Google Places retention policies (data is used for discovery only, not cached).
GOOGLE_MAPS_API_KEY=

# --- Discovery Engine Controls & Rate Limits (Optional, Defaults shown) ---
# Maximum company candidates processed in a single background execution run.
DISCOVERY_MAX_COMPANIES_PER_RUN=20

# Maximum parallel network requests during website validation and board checks.
DISCOVERY_MAX_CONCURRENCY=3

# HTTP timeout in milliseconds for outgoing website probes and board requests.
DISCOVERY_REQUEST_TIMEOUT_MS=8000

# --- Production Scheduled Trigger Security (Required for Cron / Vercel Scheduled Tasks) ---
# Shared bearer secret required in Authorization: Bearer <token> or ?secret=<token>
# to trigger automated background discovery runs via POST /api/discovery/cron.
DISCOVERY_CRON_SECRET=
